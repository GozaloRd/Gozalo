# ==========================================
# URL del backend (REQUERIDA en produccion)
# ==========================================
# En local: http://localhost:4000
# En Vercel: pega aqui la URL que te da Render para el servicio gozalo-api,
# por ejemplo https://gozalo-api.onrender.com (sin / al final).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opcional: tiempo maximo de espera del cliente a la API (ms). Por defecto 45000 en lib/api.ts.
# NEXT_PUBLIC_API_TIMEOUT_MS=

# Verificacion de Google Search Console (meta tag). Copia el token que te da Search Console.
GOOGLE_SITE_VERIFICATION=

# Opcional: Google Tag Manager - ID con formato GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID=

# Opcional: Google Analytics 4 - ID con formato G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
