# Variables de entorno del backend Gozalo
# Copia este archivo a backend/.env y rellena los valores.
# En produccion (Render) defines estos mismos valores en Settings -> Environment.

# ==========================================
# Entorno
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# Base de datos (PostgreSQL)
# ==========================================
# --- Recomendado: Postgres con Docker (raiz del repo) ---
# En la raiz: docker compose up -d
# El compose expone el puerto 5433 y crea la base gozalo_db (ver docker-compose.yml).
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=gozalo_db
# DB_USER=postgres
# DB_PASSWORD=gozalo_dev_secret

# Opcion A) Postgres instalado en el equipo (puerto por defecto 5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gozalo
DB_USER=postgres
DB_PASSWORD=

# Opcion B) Connection string completa (tiene prioridad sobre los DB_* de arriba)
# Para Supabase: Project Settings -> Database -> Connection string -> URI.
# Usa el Pooler en modo Session (puerto 6543) para Render free.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Fuerza SSL (Supabase / Neon / Render / Heroku / RDS lo requieren).
# Se activa automaticamente con NODE_ENV=production o si DATABASE_URL apunta a un host gestionado.
# DB_SSL=true

# Solo en el PRIMER deploy con DB vacia: deja "1" para que Sequelize cree las tablas.
# Despues de la primera arrancada exitosa, cambia a "0".
DB_SYNC_ALTER=1

# ==========================================
# Autenticacion
# ==========================================
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
JWT_EXPIRES_IN=7d

# ==========================================
# CORS - dominios del frontend permitidos
# ==========================================
# Una o varias URLs separadas por coma (sin / final).
FRONTEND_URL=http://localhost:3000

# Regex opcional para permitir previews de Vercel automaticamente.
# FRONTEND_URL_REGEX=^https://.*\.vercel\.app$

# ==========================================
# Email transaccional (opcional, Resend)
# ==========================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Gozalo <no-reply@tu-dominio.com>

# ==========================================
# Seed de admin (solo para crear el primer usuario)
# Uso: npm run seed:admin
# ==========================================
# SEED_ADMIN_EMAIL=admin@gozalo.com
# SEED_ADMIN_PASSWORD=cambia-esta-clave
# SEED_ADMIN_NAME=Administrador Gozalo
