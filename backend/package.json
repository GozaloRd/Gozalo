{
  "name": "gozalo-backend",
  "version": "1.0.0",
  "description": "API Gózalo - Gestión de ocio nocturno RD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:check": "node scripts/check-db.js",
    "db:align": "node scripts/align-postgres-password.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:dev": "node scripts/seed-dev-data.js",
    "seed:events": "node scripts/seed-events.js",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "resend": "^4.8.0",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
